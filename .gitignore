# SOPS secrets live here. Only sops-ENCRYPTED ciphertext may be committed
# (e.g. secrets/head.yaml). Guard against plaintext edits/backups: never
# track those forms.
secrets/*.plaintext
secrets/*.dec.yaml
secrets/*.decrypted
secrets/*.bak
secrets/*~

# nix build output symlinks (nh os build / nix-build) — machine-local artifacts
/result
/result-*
