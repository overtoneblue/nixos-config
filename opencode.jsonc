{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "permission": "allow",
  "provider": {
    "openai": {
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    },
    "makora": {
      "name": "Makora",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://inference.makora.com/v1",
        "apiKey": "{env:MAKORA_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash": {
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "google/gemma-4-26B-A4B": {},
        "moonshotai/Kimi-K3": {},
        "zai-org/GLM-5.2-FP8": {},
        "zai-org/GLM-5.2-NVFP4": {}
      }
    },
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {},
        "deepseek-v4-pro": {},
        "deepseek-v4-flash-vision-exp": {}
      }
    }
  }
}
