+/// Monitor geometry reported by `hyprctl monitors -j`. The fields are enough
+/// to compute each output's logical on-screen footprint, accounting for the
+/// per-output scale factor and 90°/270° rotation (which swaps logical W/H).
+#[derive(Debug, Clone, Default, Deserialize)]
+pub struct HyprlandMonitorInfo {
+    pub name: Option<String>,
+    pub x: i32,
+    pub y: i32,
+    pub width: u32,
+    pub height: u32,
+    #[serde(default)]
+    pub scale: f64,
+    #[serde(default)]
+    pub transform: i32,
+    #[serde(default)]
+    pub focused: bool,
+}
+
+impl HyprlandMonitorInfo {
+    /// Logical on-screen footprint `(x, y, width, height)` in global logical
+    /// desktop space. `x`/`y` are already logical positions; the physical
+    /// `width`/`height` are divided by `scale`, and for transform 1/3 (90°/270°,
+    /// including my rotated DP-1) the logical width and height are swapped.
+    pub fn logical_rect(&self) -> (i32, i32, u32, u32) {
+        let scale = if self.scale.is_finite() && self.scale > 0.0 {
+            self.scale
+        } else {
+            1.0
+        };
+        let (physical_w, physical_h) = (
+            (self.width as f64 / scale).round() as u32,
+            (self.height as f64 / scale).round() as u32,
+        );
+        let (logical_w, logical_h) = match self.transform {
+            // 90° (1) and 270° (3): the logical footprint is rotated.
+            1 | 3 => (physical_h, physical_w),
+            // 0° and 180°: no W/H swap.
+            _ => (physical_w, physical_h),
+        };
+        (self.x, self.y, logical_w, logical_h)
+    }
+}
+
+/// Query the current Hyprland output/monitor layout (read-only).
+pub async fn monitor_layout() -> Result<Vec<HyprlandMonitorInfo>> {
+    let output = hyprctl_output_async(&["monitors", "-j"])
+        .await
+        .context("failed to run hyprctl monitors -j")?;
+    if !output.status.success() {
+        bail!(
+            "hyprctl monitors -j failed: {}",
+            String::from_utf8_lossy(&output.stderr).trim()
+        );
+    }
+    let monitors: Vec<HyprlandMonitorInfo> = serde_json::from_slice(&output.stdout)
+        .context("failed to parse hyprctl monitors -j output")?;
+    if monitors.is_empty() {
+        bail!("hyprctl monitors -j returned no monitors");
+    }
+    Ok(monitors)
+}
