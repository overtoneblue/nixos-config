+    /// and rotated layouts are handled consistently with window targeting.
+    /// Returns the resolved monitor name, its logical width/height, and the
+    /// capture-space crop rectangle.
+    async fn monitor_crop_rect_for_capture(
+        &self,
+        monitor: &str,
+        raw: &RawScreenshotCapture,
+    ) -> Result<(String, u32, u32, (i32, i32, u32, u32))> {
+        let outputs = crate::windowing::backends::hyprland::monitor_layout()
+            .await
+            .map_err(|error| {
+                anyhow::anyhow!(
+                    "monitor targeting requires a Hyprland compositor \
+                     (hyprctl monitors -j): {error:#}"
+                )
+            })?;
+        let target = if monitor == "focused" {
